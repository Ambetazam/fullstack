const user_one = 'normalUser'; const password_user_one = 'simple1234'; let wrong = 2; while (wrong > 0) { let user_input = prompt('Insert your User:'); let password_input = prompt('Insert your Password:'); if ( user_one === user_input && password_user_one === password_input ) { console.log(`Welcome ${user_input}!`); console.log("Login successful!"); break; } else { wrong--; if (wrong > 0) { console.log( `Incorrect User or Password.\n` + `Please try again.\n` + `${wrong} attempts left!` ); } else { console.log( "Incorrect User or Password.\n" + "Your current session has been locked!" ); } } }
