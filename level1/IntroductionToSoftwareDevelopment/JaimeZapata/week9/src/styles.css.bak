.main-container{
	width: 100%;
	height: 100vh;
	font-family: Tahoma;
}


.left-column{

}


.side-bar-left{
	width: 25%;
	height: 100%;
	background-color: 121212;
	color: 6f5d24;	
}

.title.header{
	color: 6f5d24;
}
.subtitle-header{
	color: a0a0a0;	;
}


.sidebar-links{
	background-color: 121212;
	color: f5e7ba;
}


.main-right{
	width: 75%;
	height: 80%;
	display: flex;
	flex-direction: column;
}

.hero{
	width: 100%;
	heigth: 48vh;
	color: 6f5d24;
	background-color: 1a1a1a;
}
.main-title{
	justify-content: center;
	color: 6f5d24;
	background-color: 1a1a1a;
}
.main-par{
	justify-content: center;
	color: a0a0a0;
}

.design{
	rigth: 0;
	justify-content: right;
}




.features{
	width: 100%;
	heigth: 32vh;
	justify-content: center;
}
.h2-left{
	justify-content: center;
	color: 6f5d24;
	left: 0;
}
.par-left{
	justify-content: center;
	color: a0a0a0;
	left: 0;
}
.h2-rigth{
	justify-content: center;
	color: 6f5d24;
	right: 0;	
}
.features-rigth{
	justify-content: center;
	color: a0a0a0;
	rigth: 0;

}




.footer{
	width: 75%;
	heigth: 20%;
	flex-direction: column;
	background-color: 121212;
}

.under{
	top: 1;
}
.footer-left{
	justify-content: center;
	color: a0a0a0;
	left: 0;
}
.footer-rigth{
	justify-content: center;
	color: 6f5d24;	
	rigth: 0;	
}



