    <title>Final Assessment</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body class="main-container">

	<aside class="left-column">
		<header class="side-bar-left">
			<h1 class="title-header">LUMINA</h1>
			<p class="subtitle-header">ALTA COCINA CONTEMPORANEA</p>
		</header>

		<nav>
			<a href="#" class="sidebar-links">Menu Degustacion</a>
			<a href="#" class="sidebar-links">Carta de Vinos</a>
			<a href="#" class="sidebar-links">Reservas</a>
			<a href="#" class="sidebar-links">Nuestra Historia</a>
		</nav>
	</aside>


	<main class="main-right">

		<section class="hero">
			<h1 class="main-title">UNA EXPERIENCIA EXTRASENSORIAL</h1>
			<p class="main-par">Descubre saboresque despiertan el alma.</p>
			<img class="desing" src="./src/images/desing.avif">
		</section>

		<section class="features">
			<div class="features-left">
